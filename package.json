{
  "name": "andrewginns.github.io",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Andrew Ginns \u2014 Deployment Engineer, AI and practical systems",
  "engines": {
    "node": "^22.23.4 || ^24.16.0 || >=26.3.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write src tests *.ts *.json README.md .github/workflows/*.yml",
    "format:check": "prettier --check src tests *.ts *.json README.md .github/workflows/*.yml",
    "validate": "npm run check && npm run lint",
    "test": "playwright test"
  },
  "author": "Andrew Ginns",
  "license": "MIT",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.10",
    "fast-xml-parser": "^5.12.0",
    "plotly.js-basic-dist-min": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-astro": "^3.2.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "singleQuote": true,
    "trailingComma": "all"
  }
}
