---
interface Props {
  difficulties: string[];
  providers: string[];
}
const { difficulties, providers } = Astro.props;
---

<form
  class="filter-container"
  id="merbench-filters"
  aria-label="Filter benchmark results"
>
  <fieldset>
    <legend>Difficulty</legend>
    <div class="filter-options">
      {difficulties.map((difficulty) => (
        <label>
          <input type="checkbox" name="difficulty" value={difficulty} checked />
          {difficulty.charAt(0).toUpperCase() + difficulty.slice(1)}
        </label>
      ))}
    </div>
  </fieldset>
  <fieldset>
    <legend>Provider</legend>
    <div class="filter-options">
      {providers.map((provider) => (
        <label>
          <input type="checkbox" name="provider" value={provider} checked />
          {provider}
        </label>
      ))}
    </div>
  </fieldset>
  <div class="filter-actions">
    <button type="button" id="select-all">
      Select all
    </button>
    <button type="button" id="clear-all">
      Clear all
    </button>
  </div>
  <p id="filter-status" role="status" aria-live="polite">
    Showing all recorded runs.
  </p>
</form>

<style>
  .filter-container {
    padding: 1.5rem;
    border: 1px solid var(--border-color);
    margin-block: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    background: var(--bg-secondary);
  }
  fieldset {
    min-width: 0;
    border: 0;
    padding: 0;
    margin: 0;
  }
  legend {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
  }
  .filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    cursor: pointer;
    font-size: 0.9rem;
  }
  input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--accent-primary);
  }
  .filter-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  button {
    min-height: 44px;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    background: var(--bg-primary);
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
  }
  button:hover {
    border-color: var(--accent-primary);
  }
  #filter-status {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
</style>
