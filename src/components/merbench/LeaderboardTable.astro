---
import { formatCost } from '../../lib/merbench';
import type { LeaderboardEntry } from '../../lib/merbench-types';
interface Props {
  leaderboard: LeaderboardEntry[];
}
const { leaderboard } = Astro.props;
const columns = [
  ['Model', 'Model'],
  ['Success_Rate', 'Success rate'],
  ['Avg_Cost', 'Cost / run'],
  ['Price_per_Success', 'Cost / success'],
  ['Avg_Duration', 'Duration'],
  ['Avg_Tokens', 'Tokens'],
  ['Runs', 'Runs'],
  ['Provider', 'Provider'],
];
---

<section class="leaderboard-section" aria-labelledby="leaderboard-heading">
  <h2 id="leaderboard-heading">Model leaderboard</h2>
  <p class="table-help">
    Select a column heading to sort. Scroll the table horizontally to see all
    metrics.
  </p>
  <div
    class="leaderboard-table"
    role="region"
    aria-label="Model leaderboard, scroll to see all columns"
    tabindex="0"
  >
    <table id="leaderboard-table">
      <caption class="sr-only">
        Historical Merbench results. Costs are recorded US dollars per run.
      </caption>
      <thead>
        <tr>
          <th scope="col">Rank</th>
          {columns.map(([key, label]) => (
            <th
              scope="col"
              aria-sort={key === 'Success_Rate' ? 'descending' : undefined}
            >
              <button type="button" class="sortable" data-sort-key={key}>
                {label}{' '}
                <span class="sort-indicator" aria-hidden="true">
                  {key === 'Success_Rate' ? '↓' : ''}
                </span>
              </button>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {leaderboard.map((entry, index) => (
          <tr>
            <td>{index + 1}</td>
            <td class="model-name">{entry.Model}</td>
            <td>{entry.Success_Rate.toFixed(1)}%</td>
            <td>{formatCost(entry.Avg_Cost)}</td>
            <td>{formatCost(entry.Price_per_Success)}</td>
            <td>{entry.Avg_Duration.toFixed(2)}s</td>
            <td>{Math.ceil(entry.Avg_Tokens).toLocaleString('en-GB')}</td>
            <td>{entry.Runs}</td>
            <td>{entry.Provider}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
<style is:global>
  .leaderboard-section {
    margin-block: 2rem;
    min-width: 0;
  }
  .table-help {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .leaderboard-table {
    overflow-x: auto;
    max-width: 100%;
    border: 1px solid var(--border-color);
  }
  #leaderboard-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  #leaderboard-table th,
  #leaderboard-table td {
    padding: 0.85rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
    white-space: nowrap;
  }
  #leaderboard-table th {
    background: var(--bg-secondary);
    font-size: 0.75rem;
  }
  #leaderboard-table tbody tr:hover {
    background: var(--bg-secondary);
  }
  #leaderboard-table .model-name {
    font-weight: 600;
  }
  #leaderboard-table button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  #leaderboard-table .sort-indicator {
    color: var(--accent-primary);
    min-width: 0.5rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
