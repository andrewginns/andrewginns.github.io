---
import type { Stats } from '../../lib/merbench-types';
interface Props {
  stats: Stats;
  sourceUrl: string;
}
const { stats, sourceUrl } = Astro.props;
const values = [
  { value: stats.total_runs, label: 'Evaluation runs' },
  { value: stats.models_evaluated, label: 'Models evaluated' },
  { value: stats.test_groups.length, label: 'Difficulty levels' },
];
---

<section class="summary-stats" aria-label="Evaluation summary">
  <dl class="stats-grid">
    {values.map(({ value, label }) => (
      <div class="stat-card">
        <dt class="stat-label">{label}</dt>
        <dd class="stat-value">{value.toLocaleString('en-GB')}</dd>
      </div>
    ))}
  </dl>
  <div class="summary-source">
    <p>Providers in this snapshot: {stats.providers.join(', ')}.</p>
    <a href={sourceUrl} target="_blank" rel="noopener noreferrer">
      Evaluation source ↗
    </a>
  </div>
</section>
<style>
  .summary-stats {
    margin-block: 2rem;
    border-block: 1px solid var(--border-color);
    padding-block: 1.5rem;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 0 0 1.5rem;
  }
  .stat-card {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }
  .stat-value {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--accent-primary);
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  .summary-source {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }
  .summary-source p {
    margin: 0;
    color: var(--text-secondary);
  }
  .summary-source a {
    color: var(--accent-primary);
  }
  @media (max-width: 480px) {
    .stats-grid {
      gap: 0.75rem;
    }
    .stat-label {
      font-size: 0.7rem;
    }
  }
</style>
