---
import { profile } from '../data/profile';
---

<aside class="floating-topics" aria-labelledby="topics-rail-heading">
  <p id="topics-rail-heading" class="rail-heading">
    Explore on GitHub
  </p>
  <ul class="topic-list">
    {profile.topics.map(({ label, topic }) => (
      <li>
        <a
          class="floating-topic"
          href={
            topic
              ? `https://github.com/search?q=owner%3Aandrewginns+topic%3A${encodeURIComponent(topic)}&type=repositories`
              : profile.github
          }
          aria-label={`Explore ${label} on GitHub`}
        >
          <span class="topic-label">{label}</span>
          <span class="topic-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </li>
    ))}
  </ul>
</aside>
<style>
  .floating-topics {
    display: none;
  }
  @media (min-width: 1280px) and (min-height: 560px) {
    .floating-topics {
      display: block;
      position: fixed;
      top: 3rem;
      right: max(20px, calc((100vw - 1550px) / 2));
      width: 190px;
      max-height: calc(100dvh - 5rem);
      overflow-y: auto;
      padding: 0.4rem 0.45rem 0.45rem 1rem;
      border-left: 1px solid var(--border-color);
    }
    .rail-heading {
      margin: 0 0 0.75rem;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--text-secondary);
    }
    .topic-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }
    .topic-list li {
      margin: 0;
    }
    .floating-topic {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.45rem;
      min-height: 44px;
      padding: 0.5rem 0.7rem;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      background: var(--bg-secondary);
      color: var(--text-primary);
      font-size: 0.8rem;
      font-weight: 500;
      line-height: 1.3;
      text-decoration: none;
      transition:
        border-color 0.2s,
        background-color 0.2s,
        color 0.2s,
        transform 0.2s;
    }
    .topic-arrow {
      flex-shrink: 0;
      color: var(--text-secondary);
      font-size: 0.78rem;
      transition:
        color 0.2s,
        transform 0.2s;
    }
    .floating-topic:hover,
    .floating-topic:focus-visible {
      border-color: var(--accent-primary);
      background: var(--bg-primary);
      color: var(--accent-primary);
      transform: translateY(-2px);
    }
    .floating-topic:hover .topic-arrow,
    .floating-topic:focus-visible .topic-arrow {
      color: var(--accent-primary);
      transform: translate(1px, -1px);
    }
    .floating-topic:focus-visible {
      outline-offset: 2px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-topic,
    .topic-arrow {
      transition: none;
    }
    .floating-topic:hover,
    .floating-topic:focus-visible,
    .floating-topic:hover .topic-arrow,
    .floating-topic:focus-visible .topic-arrow {
      transform: none;
    }
  }
</style>
