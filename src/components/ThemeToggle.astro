<div class="theme-control" hidden>
  <label class="theme-label" for="theme-select">
    Color theme
  </label>
  <div class="theme-select-wrap">
    <span class="theme-icon" aria-hidden="true">
      ◐
    </span>
    <select id="theme-select" name="theme">
      <option value="system">System</option>
      <option value="light">Light</option>
      <option value="dark">Dark</option>
    </select>
  </div>
  <button
    type="button"
    class="theme-toggle"
    role="switch"
    aria-label="Dark mode"
    aria-checked="false"
  >
    <span class="theme-sun" aria-hidden="true">
      ☀︎
    </span>
    <span class="theme-moon" aria-hidden="true">
      ☾
    </span>
  </button>
</div>
<script>
  type Theme = 'light' | 'dark';

  const control = document.querySelector<HTMLElement>('.theme-control');
  const select = document.querySelector<HTMLSelectElement>('#theme-select');
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  let preference: Theme | null = null;
  try {
    const stored = localStorage.getItem('theme');
    if (stored === 'light' || stored === 'dark') preference = stored;
  } catch {
    /* Storage may be disabled. */
  }
  function applyTheme() {
    const theme = preference ?? (system.matches ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
    const meta = document.querySelector<HTMLMetaElement>(
      'meta[name="color-scheme"]',
    );
    if (meta) meta.content = preference ?? 'light dark';
    if (select) select.value = preference ?? 'system';
    toggle?.setAttribute('aria-checked', String(theme === 'dark'));
    window.dispatchEvent(new CustomEvent('theme-changed'));
  }

  function savePreference(theme: Theme | null) {
    preference = theme;
    applyTheme();
    try {
      if (preference) localStorage.setItem('theme', preference);
      else localStorage.removeItem('theme');
    } catch {
      /* Theme still works without persistence. */
    }
  }

  applyTheme();
  if (control) control.hidden = false;
  select?.addEventListener('change', () => {
    const value = select.value;
    savePreference(value === 'light' || value === 'dark' ? value : null);
  });
  toggle?.addEventListener('click', () => {
    savePreference(
      document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark',
    );
  });
  system.addEventListener('change', () => {
    if (!preference) applyTheme();
  });
  window.addEventListener('storage', (event) => {
    if (event.key !== 'theme' && event.key !== null) return;
    preference =
      event.newValue === 'light' || event.newValue === 'dark'
        ? event.newValue
        : null;
    applyTheme();
  });
</script>
<style>
  .theme-control {
    width: 100%;
  }
  .theme-control[hidden] {
    display: none;
  }
  .theme-label {
    display: block;
    font-size: 0.72rem;
    color: var(--text-secondary);
    margin-bottom: 0.35rem;
  }
  .theme-select-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .theme-icon {
    position: absolute;
    left: 0.7rem;
    font-size: 1.15rem;
    line-height: 1;
    color: var(--text-secondary);
    pointer-events: none;
  }
  select,
  .theme-toggle {
    min-height: 44px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--bg-primary);
    color: var(--text-secondary);
    font: inherit;
    cursor: pointer;
  }
  select {
    width: 100%;
    padding: 0.55rem 0.75rem 0.55rem 2.15rem;
    font-size: 0.8rem;
  }
  .theme-toggle {
    display: none;
    width: 44px;
    padding: 0;
    font-size: 1.35rem;
    line-height: 1;
  }
  select:hover,
  .theme-toggle:hover {
    border-color: var(--accent-primary);
    color: var(--text-primary);
  }
  .theme-moon,
  .theme-toggle[aria-checked='true'] .theme-sun {
    display: none;
  }
  .theme-toggle[aria-checked='true'] .theme-moon {
    display: block;
  }
  @media (max-width: 1023px) {
    .theme-control {
      width: auto;
    }
    .theme-label,
    .theme-select-wrap {
      display: none;
    }
    .theme-toggle {
      display: grid;
      place-items: center;
    }
  }
</style>
