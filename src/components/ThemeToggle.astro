<button
  id="theme-toggle"
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Dark mode"
  hidden
>
  <span class="theme-icon" aria-hidden="true">
    ◐
  </span>
  <span>Dark mode</span>
  <span class="toggle-track" aria-hidden="true">
    <span></span>
  </span>
</button>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  let preference: 'light' | 'dark' | null = null;
  try {
    const stored = localStorage.getItem('theme');
    if (stored === 'light' || stored === 'dark') preference = stored;
  } catch {
    /* Storage may be disabled. */
  }
  function applyTheme() {
    const theme = preference ?? (system.matches ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
    const meta = document.querySelector<HTMLMetaElement>(
      'meta[name="color-scheme"]',
    );
    if (meta) meta.content = preference ?? 'light dark';
    toggle?.setAttribute('aria-checked', String(theme === 'dark'));
    window.dispatchEvent(new CustomEvent('theme-changed'));
  }
  applyTheme();
  if (toggle) toggle.hidden = false;
  toggle?.addEventListener('click', () => {
    const theme =
      document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    preference = theme === (system.matches ? 'dark' : 'light') ? null : theme;
    applyTheme();
    try {
      if (preference) localStorage.setItem('theme', preference);
      else localStorage.removeItem('theme');
    } catch {
      /* Theme still works without persistence. */
    }
  });
  system.addEventListener('change', () => {
    if (!preference) applyTheme();
  });
  window.addEventListener('storage', (event) => {
    if (event.key !== 'theme' && event.key !== null) return;
    preference =
      event.newValue === 'light' || event.newValue === 'dark'
        ? event.newValue
        : null;
    applyTheme();
  });
</script>
<style>
  button {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    min-height: 44px;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--bg-primary);
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  button[hidden] {
    display: none;
  }
  button:hover {
    border-color: var(--accent-primary);
  }
  .theme-icon {
    font-size: 1.25rem;
  }
  .toggle-track {
    margin-left: auto;
    width: 30px;
    height: 18px;
    border-radius: 20px;
    background: var(--border-color);
    padding: 3px;
  }
  .toggle-track span {
    display: block;
    height: 12px;
    width: 12px;
    border-radius: 50%;
    background: var(--text-secondary);
    transition: transform 0.2s;
  }
  [aria-checked='true'] .toggle-track span {
    transform: translateX(12px);
    background: var(--accent-primary);
  }
</style>
