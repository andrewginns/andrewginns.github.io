---
import { profile } from '../data/profile';
---

<div class="hero-card">
  <svg
    class="hero-lines"
    viewBox="0 0 800 330"
    preserveAspectRatio="none"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M-30 90 C60 -20 160 100 240 35 S340 55 390 -20"
      stroke="var(--accent-primary)"
    />
    <path
      d="M460 350 C550 200 610 340 700 270 S770 260 840 190"
      stroke="var(--accent-secondary)"
    />
    <circle
      cx="132"
      cy="44"
      r="5"
      fill="var(--bg-primary)"
      stroke="var(--accent-primary)"
    />
    <circle
      cx="697"
      cy="272"
      r="5"
      fill="var(--bg-primary)"
      stroke="var(--accent-secondary)"
    />
  </svg>
  <img
    src="/andrew-headshot.jpeg"
    alt="Andrew Ginns"
    width="200"
    height="200"
    fetchpriority="high"
    class="hero-image"
  />
  <div class="hero-copy">
    <h1>Hi, I'm Andrew</h1>
    <p class="hero-role">
      {profile.role} at <strong>{profile.company}</strong>
    </p>
    <p class="hero-description">
      I help teams turn AI ideas into reliable, useful systems.
    </p>
    <div class="hero-links">
      <a href="/projects_github" class="button button-primary">
        View projects <span aria-hidden="true">↗</span>
      </a>
      <a href="/contact_me" class="button">
        Get in touch <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>
<style>
  .hero-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2.5rem 2rem;
    margin-bottom: 3rem;
    background: linear-gradient(135deg, var(--bg-secondary), var(--bg-primary));
    border: 1px solid var(--border-color);
    border-radius: 16px;
    box-shadow: 0 6px 18px var(--shadow-light);
  }
  .hero-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.3;
    background-image:
      linear-gradient(var(--border-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: linear-gradient(130deg, #000, transparent 65%);
  }
  .hero-lines {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    z-index: -1;
    opacity: 0.35;
  }
  .hero-image {
    flex: 0 0 auto;
    width: clamp(140px, 15vw, 200px);
    height: clamp(140px, 15vw, 200px);
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 8px 20px var(--shadow-medium);
  }
  .hero-copy {
    min-width: 0;
  }
  h1 {
    font-size: clamp(1.8rem, 2.8vw, 2.6rem);
    margin: 0 0 0.65rem;
    letter-spacing: -0.035em;
  }
  .hero-role {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }
  .hero-role strong {
    color: var(--text-primary);
    font-weight: 600;
  }
  .hero-description {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .hero-links {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  @media (max-width: 1000px) and (min-width: 768px) {
    .hero-card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 600px) {
    .hero-card {
      flex-direction: column;
      text-align: center;
      padding: 2rem 1.25rem;
      gap: 1.5rem;
    }
    .hero-image {
      width: 150px;
      height: 150px;
    }
    .hero-links {
      justify-content: center;
    }
  }
</style>
