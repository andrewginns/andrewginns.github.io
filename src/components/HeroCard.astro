---
import { profile } from '../data/profile';
---

<div class="hero-card">
  <img
    src="/andrew-headshot.jpeg"
    alt="Andrew Ginns"
    width="200"
    height="200"
    fetchpriority="high"
    class="hero-image"
  />
  <div class="hero-copy">
    <h1>Hi, I'm Andrew</h1>
    <p class="hero-role">
      {profile.role} at <strong>{profile.company}</strong>
    </p>
    <p class="hero-description">
      I help teams turn AI ideas into reliable, useful systems.
    </p>
    <div class="hero-links">
      <a href="/projects_github" class="button button-primary">
        View projects <span aria-hidden="true">↗</span>
      </a>
      <a href="/contact_me" class="button">
        Get in touch <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>
<style>
  .hero-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2.5rem 2rem;
    margin-bottom: 3rem;
    background: linear-gradient(135deg, var(--bg-secondary), var(--bg-primary));
    border: 1px solid var(--border-color);
    border-radius: 16px;
    box-shadow: 0 6px 18px var(--shadow-light);
  }
  .hero-image {
    flex: 0 0 auto;
    width: clamp(120px, 16vw, 200px);
    height: clamp(120px, 16vw, 200px);
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 8px 20px var(--shadow-medium);
  }
  .hero-copy {
    min-width: 0;
  }
  h1 {
    font-size: clamp(1.8rem, 2.8vw, 2.6rem);
    margin: 0 0 0.65rem;
    letter-spacing: -0.035em;
  }
  .hero-role {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }
  .hero-role strong {
    color: var(--text-primary);
    font-weight: 600;
  }
  .hero-description {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .hero-links {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  @media (max-width: 600px) {
    .hero-card {
      flex-direction: column;
      text-align: center;
      padding: 1.35rem 1.1rem;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .hero-image {
      width: 104px;
      height: 104px;
    }
    h1 {
      font-size: 1.65rem;
      margin-bottom: 0.4rem;
    }
    .hero-role {
      font-size: 0.95rem;
      margin-bottom: 0.55rem;
    }
    .hero-description {
      font-size: 0.94rem;
      line-height: 1.55;
      margin-bottom: 1rem;
    }
    .hero-links {
      justify-content: center;
      gap: 0.5rem;
    }
  }
</style>
