---
import BaseLayout from '../layouts/BaseLayout.astro';
import SummaryStats from '../components/merbench/SummaryStats.astro';
import LeaderboardTable from '../components/merbench/LeaderboardTable.astro';
import CombinedFilters from '../components/merbench/CombinedFilters.astro';
import ChartContainer from '../components/merbench/ChartContainer.astro';
import { getFilteredData } from '../lib/merbench';
import type { MerbenchData } from '../lib/merbench-types';
import merbenchData from '../data/merbench_data.json';
import plotlyUrl from 'plotly.js-basic-dist-min/plotly-basic.min.js?url';

const data = merbenchData as MerbenchData;
const { stats } = data;
const difficulties = ['easy', 'medium', 'hard'];
const initial = getFilteredData(
  difficulties,
  data.raw_data,
  data.test_groups_data,
  stats.providers,
);
// Embed only the inputs the filters need, escaping HTML parser boundaries.
const chartData = JSON.stringify({
  raw_data: data.raw_data,
  test_groups_data: data.test_groups_data,
}).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Merbench archive — Andrew Ginns"
  description="An archived evaluation of language models writing and debugging Mermaid diagrams with MCP tools. Explore historical results, costs, and failure modes."
  bodyClass="wide-content"
>
  <div class="merbench-content">
    <p class="eyebrow">Research / evaluation</p>
    <h1>Merbench</h1>
    <p class="intro">
      Can a language model write a diagram, check its work, and fix its
      mistakes?
    </p>
    <aside class="archive-note" aria-label="Benchmark status">
      <strong>Legacy · Saturated</strong>
      <p>
        This benchmark is no longer maintained and is considered saturated. The
        results are preserved as a record of the experiment, rather than a
        current comparison of model capabilities.
      </p>
    </aside>
    <p>
      Merbench evaluates how well language models write and debug Mermaid
      diagrams using an MCP validation tool. Models have up to five attempts per
      test case across three difficulty levels. Success reflects both valid
      diagram syntax and effective use of feedback.
    </p>
    <p class="data-note">
      Costs are the recorded US dollar values from these historical runs, not
      current provider prices. A recorded zero does not establish that a model
      is free to run. Missing costs are shown as N/A.
    </p>

    <SummaryStats
      stats={stats}
      sourceUrl="https://github.com/andrewginns/agents-mcp-usage/tree/main/agents_mcp_usage/evaluations/mermaid_evals"
    />
    <CombinedFilters difficulties={difficulties} providers={stats.providers} />
    <noscript>
      <style is:inline>
        #merbench-filters {
          display: none;
        }
      </style>
      <p>
        Filtering and charts require JavaScript. The complete leaderboard is
        available below.
      </p>
    </noscript>

    <details class="metrics-glossary">
      <summary>How to read the results</summary>
      <dl>
        <dt>Success rate</dt>
        <dd>The percentage of runs that produced a valid Mermaid diagram.</dd>
        <dt>Cost / run</dt>
        <dd>
          Mean recorded cost of a complete run, including attempts and tool
          feedback.
        </dd>
        <dt>Cost / success</dt>
        <dd>
          Mean cost divided by success rate. Unavailable when there are no
          successful runs or no recorded cost.
        </dd>
        <dt>Duration</dt>
        <dd>Mean elapsed time per run in seconds.</dd>
        <dt>Tokens</dt>
        <dd>Mean total token usage per run.</dd>
        <dt>Runs</dt>
        <dd>The number of evaluation runs included after filtering.</dd>
      </dl>
    </details>
    <LeaderboardTable leaderboard={initial.leaderboard} />
    <ChartContainer chartId="pareto-chart" title="Performance & efficiency" />
    <ChartContainer
      chartId="test-group-chart"
      title="Performance by difficulty"
    />
    <ChartContainer chartId="token-chart" title="Token usage" />
    <ChartContainer chartId="failure-analysis-chart" title="Failure analysis" />
  </div>
  <script is:inline src={plotlyUrl} defer></script>
  <script
    is:inline
    type="application/json"
    id="merbench-data"
    set:html={chartData}
  />
</BaseLayout>
<script>
  import '../scripts/merbench-init';
</script>
<style>
  .merbench-content {
    width: 100%;
    min-width: 0;
  }
  .intro {
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    max-width: 40rem;
    line-height: 1.5;
  }
  .archive-note {
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--accent-primary);
    background: var(--bg-secondary);
    padding: 1.25rem 1.5rem;
    margin-block: 2rem;
  }
  .archive-note strong {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }
  .archive-note p {
    margin: 0.5rem 0 0;
    max-width: 65rem;
  }
  .data-note {
    color: var(--text-secondary);
    font-size: 0.9rem;
    max-width: 60rem;
    margin-bottom: 2rem;
  }
  .metrics-glossary {
    border-bottom: 1px solid var(--border-color);
    padding-block: 1rem;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    min-height: 44px;
  }
  dl {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 0.75rem 1.5rem;
    font-size: 0.9rem;
    margin: 1rem 0;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
    color: var(--text-secondary);
  }
  @media (max-width: 600px) {
    dl {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
    dd {
      margin-bottom: 0.75rem;
    }
  }
</style>
