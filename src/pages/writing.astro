---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getMediumArticles } from '../lib/medium';
import { profile } from '../data/profile';
const [localPosts, mediumArticles] = await Promise.all([
  getCollection('writing', ({ data }) => !data.draft),
  getMediumArticles(),
]);
const posts = [
  ...localPosts.map((post) => ({
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    tags: post.data.tags,
    url: `/writing/${post.id}/`,
    source: 'Notes',
  })),
  ...mediumArticles.map((post) => ({
    title: post.title,
    description: post.description,
    date: new Date(post.publishedAt),
    tags: post.tags,
    url: post.url,
    source: 'Medium',
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<BaseLayout
  title="Writing — Andrew Ginns"
  description="Notes from Andrew Ginns on practical machine learning, AI systems, MLOps, and technical leadership."
>
  <h1>Writing</h1>
  <p class="page-intro">
    Notes from building things: practical machine learning, AI systems, MLOps,
    and lessons from working with technical teams.
  </p>
  {posts.length > 0 ? (
    <div class="posts-list">
      {posts.map((post) => (
        <article class="post-preview">
          <div class="post-meta">
            <time datetime={post.date.toISOString()}>
              {post.date.toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
            <span class="badge">{post.source}</span>
          </div>
          <h2>
            <a href={post.url}>
              {post.title}
              {post.source === 'Medium' && <span aria-hidden="true"> ↗</span>}
            </a>
          </h2>
          {post.description && <p>{post.description}</p>}
          <div class="tags">
            {post.tags?.slice(0, 5).map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="writing-fallback">
      <h2>Find my writing on Medium</h2>
      <p>Read my published articles and follow along for new posts.</p>
      <a class="button" href={profile.medium}>
        Read on Medium ↗
      </a>
    </div>
  )}
  {posts.length > 0 && (
    <p class="publication-link">
      <a href={profile.medium}>More on Medium ↗</a>
    </p>
  )}
</BaseLayout>
<style>
  .post-preview {
    padding: 0 0 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--text-secondary);
    font-size: 0.77rem;
  }
  .post-preview h2 {
    font-size: 1.35rem;
    margin: 0.7rem 0 1rem;
  }
  .post-preview h2 a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .post-preview h2 a:hover {
    color: var(--accent-primary);
  }
  .post-preview p {
    color: var(--text-secondary);
  }
  .writing-fallback {
    padding: 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
  }
  .writing-fallback h2 {
    margin-top: 0;
  }
  .writing-fallback p {
    color: var(--text-secondary);
  }
  .publication-link {
    margin-top: 2rem;
  }
</style>
