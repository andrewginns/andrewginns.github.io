---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCard from '../components/HeroCard.astro';
import { profile } from '../data/profile';
import { featuredProjects } from '../data/projects';
---

<BaseLayout title={`Andrew Ginns — ${profile.role} at ${profile.company}`}>
  <HeroCard />
  <section class="home-section" aria-labelledby="what-i-do">
    <h2 id="what-i-do">What I do</h2>
    <p>
      I'm a {profile.role} at {profile.company}, helping customers design and
      build AI applications that meet real business needs. My background spans
      hands-on machine learning engineering, MLOps, and leading data science
      teams.
    </p>
    <a class="text-link" href="/experience">
      Explore my experience <span aria-hidden="true">→</span>
    </a>
  </section>
  <section class="home-section" aria-labelledby="recent-focus">
    <h2 id="recent-focus">Recent focus</h2>
    <p>
      Large language models, agentic systems, and the engineering that makes
      them useful: tools, evaluations, and reliable production workflows.
    </p>
  </section>
  <section class="home-section" aria-labelledby="selected-work">
    <div class="section-heading">
      <h2 id="selected-work">Selected work</h2>
      <a href="/projects_github">All projects →</a>
    </div>
    <div class="selected-projects">
      {featuredProjects.slice(0, 2).map((project) => (
        <a class="selected-project" href={project.html_url}>
          <span class="project-label">
            Open source <span aria-hidden="true">↗</span>
          </span>
          <h3>{project.name}</h3>
          <p>{project.description}</p>
        </a>
      ))}
    </div>
    <a class="archive-link" href="/merbench">
      Merbench <span class="badge">Legacy · Saturated</span>
      <span>Explore the archived agent benchmark →</span>
    </a>
  </section>
  <section class="home-section connect-section" aria-labelledby="connect">
    <h2 id="connect">Let's connect</h2>
    <p>
      Interested in practical AI, open source, or building great technical
      teams? I'd be glad to compare notes.
    </p>
    <a class="text-link" href={profile.linkedin}>
      Find me on LinkedIn ↗
    </a>
  </section>
</BaseLayout>
<style>
  .home-section {
    margin-bottom: 2.75rem;
  }
  .home-section h2 {
    margin: 0 0 1.1rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--accent-primary);
  }
  .home-section p {
    color: var(--text-secondary);
  }
  .text-link {
    font-size: 0.9rem;
    font-weight: 550;
    text-decoration: none;
  }
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .section-heading > a {
    font-size: 0.78rem;
    text-decoration: none;
  }
  .selected-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .selected-project {
    display: block;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.25rem;
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .selected-project:hover {
    border-color: var(--accent-primary);
    transform: translateY(-3px);
  }
  .project-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .selected-project h3 {
    font-size: 1rem;
    overflow-wrap: anywhere;
    margin: 0.8rem 0;
  }
  .selected-project p {
    font-size: 0.85rem;
    line-height: 1.7;
    margin: 0;
  }
  .archive-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    padding: 1.1rem 0;
    font-size: 0.82rem;
    text-decoration: none;
    color: var(--text-primary);
  }
  .archive-link > span:last-child {
    color: var(--text-secondary);
    font-size: 0.77rem;
  }
  .connect-section {
    padding-top: 1.75rem;
    border-top: 1px solid var(--border-color);
  }
  @media (max-width: 520px) {
    .selected-projects {
      grid-template-columns: 1fr;
    }
  }
</style>
