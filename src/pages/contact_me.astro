---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout
  title="Contact — Andrew Ginns"
  description="Connect with Andrew Ginns on LinkedIn or GitHub to discuss practical AI, open source, and engineering."
>
  <h1>Get in touch</h1>
  <p class="page-intro">
    Good conversations often lead to interesting things. Whether it's practical
    AI, an open-source idea, or a shared curiosity, I'd be glad to hear from
    you.
  </p>
  <div class="contact-methods">
    <a class="contact-card" href={profile.linkedin}>
      <span class="eyebrow">Let's talk</span>
      <h2>
        LinkedIn <span aria-hidden="true">↗</span>
      </h2>
      <p>The best place for professional conversations and connecting.</p>
      <span class="contact-address">linkedin.com/in/andrewginns</span>
    </a>
    <a class="contact-card" href={profile.github}>
      <span class="eyebrow">Let's build</span>
      <h2>
        GitHub <span aria-hidden="true">↗</span>
      </h2>
      <p>Explore my code, raise an issue, or contribute to a project.</p>
      <span class="contact-address">github.com/andrewginns</span>
    </a>
  </div>
  <section class="availability">
    <h2>Currently at {profile.company}</h2>
    <p>
      I'm focused on my role as a {profile.role}, and always open to exchanging
      ideas about AI, developer tools, and the craft of building useful systems.
    </p>
  </section>
</BaseLayout>
<style>
  .contact-methods {
    display: grid;
    gap: 1.25rem;
  }
  .contact-card {
    display: block;
    border: 1px solid var(--border-color);
    padding: 1.6rem;
    border-radius: 12px;
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .contact-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
  }
  .contact-card h2 {
    display: flex;
    justify-content: space-between;
    margin: 0.5rem 0 1rem;
  }
  .contact-card h2 span {
    color: var(--accent-primary);
  }
  .contact-card p {
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }
  .contact-address {
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  .availability {
    margin-top: 2.5rem;
  }
  .availability h2 {
    font-size: 1.2rem;
  }
  .availability p {
    color: var(--text-secondary);
  }
</style>
