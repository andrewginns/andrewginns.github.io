---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedProjects } from '../lib/github';
import { profile } from '../data/profile';
const projects = await getFeaturedProjects();
---

<BaseLayout
  title="Projects — Andrew Ginns"
  description="Open-source projects by Andrew Ginns: AI agents, developer tools, model evaluation, and machine learning experiments."
>
  <h1>Projects</h1>
  <p class="page-intro">
    Tools, experiments, and things I've built along the way. A selection of my
    open-source work in AI, machine learning, and beyond.
  </p>
  <div class="projects-grid">
    {projects.map((project, index) => (
      <a
        class="project-card"
        href={project.html_url}
        aria-labelledby={`project-title-${index}`}
      >
        <div class="project-meta">
          <span>{project.language || 'Open source'}</span>
          {project.stargazers_count !== undefined && (
            <span aria-label={`${project.stargazers_count} GitHub stars`}>
              ☆ {project.stargazers_count}
            </span>
          )}
        </div>
        <h2 id={`project-title-${index}`}>
          <span>{project.name}</span>
          <span class="card-arrow" aria-hidden="true">
            ↗
          </span>
        </h2>
        <p>{project.description}</p>
        {project.topics.length > 0 && (
          <div class="tags">
            {project.topics.slice(0, 5).map((topic) => (
              <span class="tag">{topic}</span>
            ))}
          </div>
        )}
      </a>
    ))}
  </div>
  <section class="benchmark-archive">
    <span class="badge">Legacy · Saturated</span>
    <h2>
      <a href="/merbench">Merbench →</a>
    </h2>
    <p>
      An archived benchmark exploring how AI agents use tools to generate valid
      Mermaid diagrams. No longer updated; the original results remain available
      to explore.
    </p>
  </section>
  <p>
    <a class="button" href={profile.github}>
      Explore more on GitHub ↗
    </a>
  </p>
</BaseLayout>
<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .project-card {
    min-width: 0;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    color: var(--text-primary);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .project-card:hover,
  .project-card:focus-visible {
    border-color: var(--accent-primary);
    transform: translateY(-3px);
  }
  .project-meta {
    display: flex;
    justify-content: space-between;
    color: var(--text-secondary);
    font-size: 0.75rem;
  }
  .project-card h2 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 1rem 0 0.75rem;
    font-size: 1.1rem;
    color: var(--text-primary);
    overflow-wrap: anywhere;
    transition: color 0.2s;
  }
  .project-card:hover h2,
  .project-card:focus-visible h2 {
    color: var(--accent-primary);
  }
  .card-arrow {
    flex-shrink: 0;
    color: var(--accent-primary);
    transition: transform 0.2s;
  }
  .project-card:hover .card-arrow,
  .project-card:focus-visible .card-arrow {
    transform: translate(2px, -2px);
  }
  .project-card p {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
  .project-card .tags {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
    gap: 0.3rem 0.65rem;
  }
  .project-card .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text-light);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.72rem;
    line-height: 1.4;
  }
  .project-card .tag:not(:last-child)::after {
    content: '';
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-light);
    opacity: 0.55;
  }
  .benchmark-archive {
    margin: 2rem 0;
    padding: 1.5rem;
    border-left: 3px solid var(--border-color);
    background: var(--bg-secondary);
    border-radius: 0 10px 10px 0;
  }
  .benchmark-archive h2 {
    margin: 0.6rem 0;
    font-size: 1.2rem;
  }
  .benchmark-archive h2 a {
    text-decoration: none;
  }
  .benchmark-archive p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
  @media (max-width: 650px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card h2,
    .card-arrow {
      transition: none;
    }
    .project-card:hover,
    .project-card:focus-visible,
    .project-card:hover .card-arrow,
    .project-card:focus-visible .card-arrow {
      transform: none;
    }
  }
</style>
