---
import SEO from '../components/SEO.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import FloatingTopics from '../components/FloatingTopics.astro';
import { profile } from '../data/profile';
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  author?: string;
  noindex?: boolean;
}
const {
  title,
  description = profile.description,
  bodyClass,
  image,
  type,
  publishDate,
  author,
  noindex,
} = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navigation = [
  ['/', 'Home'],
  ['/experience', 'Experience'],
  ['/projects_github', 'Projects'],
  ['/writing', 'Writing'],
  ['/merbench', 'Merbench'],
  ['/about_me', 'About'],
  ['/contact_me', 'Contact'],
];
const isActive = (href: string) =>
  currentPath === href ||
  (href === '/writing' && currentPath.startsWith('/writing/'));
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          /* Storage is optional. */
        }
        document.documentElement.dataset.theme =
          theme === 'light' || theme === 'dark'
            ? theme
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      })();
    </script>
    <SEO
      {title}
      {description}
      {image}
      {type}
      {publishDate}
      {author}
      {noindex}
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="sidebar">
      <div class="profile-section">
        <a href="/" class="site-title">
          Andrew Ginns<span aria-hidden="true">.</span>
        </a>
        <p class="tagline">
          {profile.role}
          <br />
          <span>at {profile.company}</span>
        </p>
      </div>
      <details class="navigation" open>
        <summary>
          Menu <span aria-hidden="true">+</span>
        </summary>
        <nav aria-label="Main navigation">
          <ul class="nav-links">
            {navigation.map(([href, label]) => (
              <li>
                <a
                  href={href}
                  aria-current={isActive(href) ? 'page' : undefined}
                >
                  {label}
                  {href === '/merbench' && (
                    <span class="legacy-label">Legacy</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
      <div class="sidebar-footer">
        <div class="social-links">
          <a href={profile.github}>GitHub ↗</a>
          <a href={profile.linkedin}>LinkedIn ↗</a>
        </div>
        <ThemeToggle />
      </div>
    </header>
    <div class="page-shell">
      <main id="main-content" class="content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Andrew Ginns</span>
        <a href={`${profile.github}/andrewginns.github.io`}>View source ↗</a>
      </footer>
    </div>
    {currentPath !== '/merbench' && <FloatingTopics />}
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.navigation');
      const mobile = window.matchMedia('(max-width: 767px)');
      function setMenuMode() {
        if (menu) menu.open = !mobile.matches;
      }
      setMenuMode();
      mobile.addEventListener('change', setMenuMode);
      menu?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobile.matches) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    </script>
  </body>
</html>
